FROM python:3.12.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AIC_MODEL_ROOT=/models \
    HF_HOME=/models/huggingface

RUN pip install --no-cache-dir huggingface-hub==0.36.0
WORKDIR /app
COPY scripts/qdrant/setup_query_models.py ./setup_query_models.py
ENTRYPOINT ["python", "/app/setup_query_models.py"]
